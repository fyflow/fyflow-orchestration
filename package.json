{
  "name": "fyflow-orchestration",
  "version": "0.7.0",
  "description": "Flow orchestration over fyflow-scheduler: sequence, decision, fan-out and join",
  "keywords": [
    "workflow",
    "orchestration",
    "flow",
    "dag",
    "fan-out",
    "join",
    "scheduler",
    "worker",
    "typescript"
  ],
  "homepage": "https://github.com/fyflow/fyflow-orchestration#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyflow/fyflow-orchestration.git"
  },
  "bugs": {
    "url": "https://github.com/fyflow/fyflow-orchestration/issues"
  },
  "type": "module",
  "main": "./dist/node/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "browser": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "types": "./dist/types/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./scheduler": {
      "node": {
        "types": "./dist/types/scheduler/index.d.ts",
        "default": "./dist/node/scheduler/index.js"
      },
      "browser": {
        "types": "./dist/types/scheduler/index.d.ts",
        "default": "./dist/browser/scheduler/index.js"
      },
      "types": "./dist/types/scheduler/index.d.ts",
      "default": "./dist/node/scheduler/index.js"
    },
    "./jsonata": {
      "node": {
        "types": "./dist/types/jsonata/index.d.ts",
        "default": "./dist/node/jsonata/index.js"
      },
      "browser": {
        "types": "./dist/types/jsonata/index.d.ts",
        "default": "./dist/browser/jsonata/index.js"
      },
      "types": "./dist/types/jsonata/index.d.ts",
      "default": "./dist/node/jsonata/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "pack:smoke:provoke": "node scripts/pack-smoke.mjs --provoke",
    "check:spec": "node scripts/check-spec.mjs",
    "check:spec:selftest": "node scripts/check-spec.mjs --self-test",
    "check:source": "node scripts/check-source.mjs",
    "check:source:selftest": "node scripts/check-source.mjs --self-test",
    "check:wiring": "node scripts/check-wiring.mjs",
    "check:wiring:selftest": "node scripts/check-wiring.mjs --self-test",
    "check:markdown": "node scripts/check-markdown.mjs",
    "check:markdown:selftest": "node scripts/check-markdown.mjs --self-test",
    "check:scheduler": "node scripts/check-scheduler.mjs",
    "check:scheduler:selftest": "node scripts/check-scheduler.mjs --self-test",
    "check:policies": "node scripts/check-policies.mjs",
    "check:policies:selftest": "node scripts/check-policies.mjs --self-test",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:selftest": "node scripts/check-docs.mjs --self-test",
    "check:workers": "node scripts/check-workers.mjs",
    "check:workers:selftest": "node scripts/check-workers.mjs --self-test",
    "check:budget": "node scripts/check-budget.mjs",
    "check:budget:selftest": "node scripts/check-budget.mjs --self-test",
    "check:register": "node scripts/check-register.mjs",
    "check:register:selftest": "node scripts/check-register.mjs --self-test",
    "lint": "deno lint src/ test/ examples/ index.ts",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "typecheck:deno": "deno check index.ts src/",
    "typecheck:tests": "tsc -p tsconfig.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:browser && npm run typecheck:deno && npm run typecheck:tests && npm run typecheck:examples",
    "test": "node test/runner.ts",
    "test:deno": "deno run --allow-read test/runner.ts",
    "build:browser-tests": "node scripts/build-browser-tests.mjs",
    "test:browser": "npm run build:browser-tests && node scripts/run-browser-tests.mjs",
    "test:browser:all": "npm run build:browser-tests && node scripts/run-browser-tests.mjs chromium firefox webkit",
    "test:l6": "node examples/l6.ts",
    "test:l6:deno": "deno run --import-map=examples/deno-import-map.json --allow-read --allow-net --allow-env examples/l6.ts",
    "state": "node scripts/state.mjs",
    "q": "node scripts/lookup.mjs q",
    "adr": "node scripts/lookup.mjs adr",
    "term": "node scripts/lookup.mjs term",
    "refs": "node scripts/lookup.mjs refs",
    "lookup:selftest": "node scripts/lookup.mjs --self-test",
    "gate:full": "npm run gate && npm run selftests",
    "gate:item": "npm run gate && node scripts/run-selftests.mjs --without check:register:selftest",
    "selftests": "node scripts/run-selftests.mjs",
    "gate": "npm run lint && npm run typecheck && npm run check:scheduler && npm run check:policies && npm run check:spec && npm run check:source && npm run check:markdown && npm run check:wiring && npm run check:workers && npm run check:docs && npm run check:budget && npm run check:register && npm run test && npm run test:deno && npm run test:browser && npm run test:l6 && npm run test:l6:deno"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.12",
    "fyflow-scheduler": "0.5.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "fyflow-scheduler": "0.5.2"
  },
  "dependencies": {
    "jsonata": "2.2.2"
  }
}
