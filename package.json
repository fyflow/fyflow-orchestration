{
  "name": "fyflow-orchestration",
  "version": "0.1.0",
  "description": "Flow orchestration over fyflow-scheduler: sequence, decision, fan-out and join",
  "type": "module",
  "main": "./dist/node/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "browser": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "types": "./dist/types/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "check:spec": "node scripts/check-spec.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:source:selftest": "node scripts/check-source.mjs --self-test",
    "check:markdown": "node scripts/check-markdown.mjs",
    "check:markdown:selftest": "node scripts/check-markdown.mjs --self-test",
    "check:scheduler": "node scripts/check-scheduler.mjs",
    "check:scheduler:selftest": "node scripts/check-scheduler.mjs --self-test",
    "check:policies": "node scripts/check-policies.mjs",
    "check:policies:selftest": "node scripts/check-policies.mjs --self-test",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:selftest": "node scripts/check-docs.mjs --self-test",
    "lint": "deno lint src/ test/ examples/ index.ts",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "typecheck:deno": "deno check index.ts src/",
    "typecheck:tests": "tsc -p tsconfig.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:browser && npm run typecheck:deno && npm run typecheck:tests && npm run typecheck:examples",
    "test": "node test/runner.ts",
    "test:deno": "deno run --allow-read test/runner.ts",
    "build:browser-tests": "node scripts/build-browser-tests.mjs",
    "test:browser": "npm run build:browser-tests && node scripts/run-browser-tests.mjs",
    "test:browser:all": "npm run build:browser-tests && node scripts/run-browser-tests.mjs chromium firefox webkit",
    "test:l6": "node examples/l6.ts",
    "test:l6:deno": "deno run --import-map=examples/deno-import-map.json --allow-read --allow-net --allow-env examples/l6.ts",
    "gate": "npm run check:spec && npm run check:source && npm run check:source:selftest && npm run check:markdown && npm run check:markdown:selftest && npm run check:scheduler && npm run check:scheduler:selftest && npm run check:policies && npm run check:policies:selftest && npm run check:docs && npm run check:docs:selftest && npm run lint && npm run typecheck && npm run test && npm run test:deno && npm run test:browser && npm run test:l6 && npm run test:l6:deno"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.12",
    "fyflow-scheduler": "0.3.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2"
  }
}
