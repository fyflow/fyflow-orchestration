{
  "flowId": "fanout-failure",
  "version": 1,
  "entry": "ingest",
  "nodes": [
    { "id": "ingest",  "kind": "task",   "type": "IngestWorker", "edges": [ { "to": "split" } ] },
    { "id": "split",   "kind": "fanout", "branches": [ "scoreA", "reviewB" ] },
    { "id": "scoreA",  "kind": "task",   "type": "ScoreWorker", "optional": true, "edges": [
        { "on": [ "failed" ], "to": "droppedA" },
        { "to": "collect" }
    ] },
    { "id": "reviewB", "kind": "task",   "type": "ReviewWorker", "edges": [
        { "on": [ "failed" ], "to": "droppedB" },
        { "to": "collect" }
    ] },
    { "id": "droppedA", "kind": "end",   "outcome": "branch-dropped" },
    { "id": "droppedB", "kind": "end",   "outcome": "branch-abandoned-by-human" },
    { "id": "collect", "kind": "join",   "of": "split",                 "edges": [ { "to": "publish" } ] },
    { "id": "publish", "kind": "task",   "type": "PublishWorker", "edges": [ { "to": "done" } ] },
    { "id": "done",    "kind": "end",    "outcome": "completed" }
  ]
}
