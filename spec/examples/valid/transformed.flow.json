{
  "flowId": "transformed",
  "version": 1,
  "entry": "ingest",
  "nodes": [
    { "id": "ingest",  "kind": "task", "type": "Scorer",
      "transform": { "lang": "path", "expr": "document" },
      "edges": [ { "to": "each" } ] },
    { "id": "each",    "kind": "map",  "over": "items", "branch": "rank" },
    { "id": "rank",    "kind": "task", "type": "Scorer", "settings": { "factor": 100 },
      "transform": { "lang": "path", "expr": "confidence" },
      "edges": [ { "to": "gather" } ] },
    { "id": "gather",  "kind": "join", "of": "each", "edges": [ { "to": "split" } ] },
    { "id": "split",   "kind": "fanout", "branches": [ "scoreA", "scoreB" ] },
    { "id": "scoreA",  "kind": "task", "type": "Scorer", "settings": { "factor": 10 },
      "needs": { "own": ".", "run": "ingest" },
      "transform": { "lang": "path", "expr": "run.config" },
      "edges": [ { "to": "collect" } ] },
    { "id": "scoreB",  "kind": "task", "type": "ScoreWorker",
      "edges": [ { "to": "collect" } ] },
    { "id": "collect", "kind": "join", "of": "split", "edges": [ { "to": "publish" } ] },
    { "id": "publish", "kind": "task", "type": "Scorer", "settings": { "factor": 1 },
      "transform": { "lang": "path", "expr": "$settings.factor" },
      "edges": [ { "to": "done" } ] },
    { "id": "done",    "kind": "end",  "outcome": "completed" }
  ]
}
