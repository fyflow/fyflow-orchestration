{
  "workers": {
    "ingest":  { "url": "corpus://ingest" },
    "score":   { "url": "corpus://score" },
    "review":  { "url": "corpus://review" },
    "publish": { "url": "corpus://publish" },
    "extract": { "url": "corpus://extract" },
    "merge":   { "url": "corpus://merge" },
    "scorer":  { "url": "corpus://scorer",
                 "settingsSchema": { "type": "object", "properties": { "factor": { "type": "number", "minimum": 0 } }, "additionalProperties": false } }
  },
  "groups": {
    "gpu": { "type": "ConcurrentLimitGroup", "config": { "limit": 1 } },
    "api": { "type": "RateLimitGroup", "config": { "windows": [ { "limit": 60, "windowMs": 60000 } ] } }
  },
  "nodeTypes": {
    "IngestWorker":  { "worker": "ingest" },
    "ScoreWorker":   { "worker": "score" },
    "ReviewWorker":  { "worker": "review" },
    "PublishWorker": { "worker": "publish" },
    "ExtractWorker": { "worker": "extract" },
    "MergeWorker":   { "worker": "merge" },
    "Scorer":        { "worker": "scorer", "config": { "role": "typed" }, "settings": { "factor": 1 } }
  },
  "pools": {
    "scorer-fast": { "type": "Scorer", "config": { "role": "typed", "fast": true } }
  },
  "predicates": [ "isLowConfidence", "isHighConfidence" ],
  "languages": [ "path" ]
}
