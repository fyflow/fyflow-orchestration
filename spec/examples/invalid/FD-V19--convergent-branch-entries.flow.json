{
  "flowId": "convergent-branches",
  "version": 1,
  "entry": "split",
  "nodes": [
    { "id": "split",   "kind": "fanout", "branches": [ "scoreA", "scoreB" ] },
    { "id": "scoreA",  "kind": "task",   "type": "ScoreWorker", "edges": [ { "to": "merge" } ] },
    { "id": "scoreB",  "kind": "task",   "type": "ScoreWorker", "edges": [ { "to": "merge" } ] },
    { "id": "merge",   "kind": "task",   "type": "MergeWorker", "edges": [ { "to": "collect" } ] },
    { "id": "collect", "kind": "join",   "of": "split",               "edges": [ { "to": "done" } ] },
    { "id": "done",    "kind": "end",    "outcome": "completed" }
  ]
}
