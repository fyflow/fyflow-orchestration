{
  "flowId": "needs-names-a-node-downstream",
  "version": 1,
  "entry": "ingest",
  "nodes": [
    { "id": "ingest",  "kind": "task", "workerType": "IngestWorker",
      "needs": { "later": "publish" },
      "edges": [ { "to": "publish" } ] },
    { "id": "publish", "kind": "task", "workerType": "PublishWorker", "edges": [ { "to": "done" } ] },
    { "id": "done",    "kind": "end",  "outcome": "completed" }
  ]
}
