{
  "flowId": "l6-map-with-context",
  "version": 1,
  "entry": "ingest",
  "nodes": [
    { "id": "ingest",  "kind": "task", "type": "SplitWorker", "edges": [ { "to": "split" } ] },
    { "id": "split",   "kind": "map",  "over": "items",             "branch": "score" },
    { "id": "score",   "kind": "task", "type": "WeighWorker",
      "needs": { "item": ".", "run": "ingest" },
      "edges": [ { "to": "collect" } ] },
    { "id": "collect", "kind": "join", "of": "split",               "edges": [ { "to": "publish" } ] },
    { "id": "publish", "kind": "task", "type": "PublishWorker", "edges": [ { "to": "done" } ] },
    { "id": "done",    "kind": "end",  "outcome": "completed" }
  ]
}
