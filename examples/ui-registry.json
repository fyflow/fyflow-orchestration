{
  "workers": {
    "split": {
      "url": "./workers/split.ts",
      "inputSchema": {
        "type": "object",
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "text": {
            "type": "string"
          }
        },
        "examples": [
          {
            "confidence": 0.7,
            "text": "alpha beta"
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "confidence",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "word",
                "confidence"
              ],
              "additionalProperties": false,
              "properties": {
                "word": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "examples": [
          {
            "confidence": 0.7,
            "items": [
              {
                "word": "alpha",
                "confidence": 0.5
              }
            ]
          }
        ]
      }
    },
    "score": {
      "url": "./workers/score.ts",
      "inputSchema": {
        "type": "object",
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "examples": [
          {
            "confidence": 0.7
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "confidence",
          "score"
        ],
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "examples": [
          {
            "confidence": 0.7,
            "score": 70
          }
        ]
      }
    },
    "weigh": {
      "url": "./workers/weigh.ts",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object",
            "properties": {
              "word": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "run": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "examples": [
          {
            "item": {
              "word": "alpha",
              "confidence": 0.5
            },
            "run": {
              "confidence": 0.8
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "keys",
          "extraKeys",
          "word",
          "confidence",
          "score"
        ],
        "additionalProperties": false,
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extraKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "word": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "examples": [
          {
            "keys": [
              "item",
              "run"
            ],
            "extraKeys": [],
            "word": "alpha",
            "confidence": 0.5,
            "score": 40
          }
        ]
      }
    },
    "publish": {
      "url": "./workers/publish.ts",
      "inputSchema": {
        "examples": [
          {
            "0": {
              "score": 1
            },
            "1": {
              "score": 2
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "published",
          "joinPayload"
        ],
        "additionalProperties": false,
        "properties": {
          "published": {
            "const": true
          },
          "joinPayload": {}
        },
        "examples": [
          {
            "published": true,
            "joinPayload": {
              "0": {
                "score": 1
              },
              "1": {
                "score": 2
              }
            }
          }
        ]
      }
    }
  },
  "nodeTypes": {
    "SplitWorker": {
      "worker": "split",
      "inline": true,
      "config": {
        "delayMs": 5
      },
      "pool": {
        "maxThreads": 1,
        "idleTimeout": 0
      }
    },
    "ScoreWorker": {
      "worker": "score",
      "config": {
        "delayMs": 5
      },
      "pool": {
        "maxThreads": 2,
        "idleTimeout": 0
      }
    },
    "WeighWorker": {
      "worker": "weigh",
      "config": {
        "delayMs": 5
      },
      "pool": {
        "maxThreads": 2,
        "idleTimeout": 0
      }
    },
    "PublishWorker": {
      "worker": "publish",
      "inline": true,
      "config": {
        "delayMs": 5
      },
      "pool": {
        "maxThreads": 1,
        "idleTimeout": 0
      }
    }
  },
  "languages": [
    "jsonata"
  ]
}
